# Copy this file to .env and fill in the values. Never commit .env.

# --- Neo4j AuraDB Free ---
# Copy these from the credentials .txt file Aura let you download when you
# created the instance. Pasting the whole file here is fine: extra keys such
# as AURA_INSTANCEID are ignored.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
# Optional. Leave unset to use the instance's default database.
# NEO4J_DATABASE=neo4j

# --- Local LLM (Ollama): free, no account or API key ---
# Install Ollama from https://ollama.com/download, then run: ollama pull qwen3:4b-instruct
# The values below are the defaults; uncomment a line only to change it.
# On a computer with 16 GB+ of memory you can try a larger model, e.g. LLM_MODEL=gemma3:12b
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=qwen3:4b-instruct
# LLM_CONTEXT_TOKENS=8192
